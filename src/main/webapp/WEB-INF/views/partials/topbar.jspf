<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<header class="topbar">
    <div class="topbar-left">
        <a class="brand" href="${pageContext.request.contextPath}/waiting">
            <span class="brand-mark">J</span>
            <span class="brand-text">JPA Store</span>
        </a>
    </div>

    <!-- Thanh tìm kiếm trung tâm (Search Bar) -->
    <div class="topbar-center">
        <form class="header-search" action="${pageContext.request.contextPath}/product" method="get">
            <input type="search" name="q" placeholder="Tìm kiếm sản phẩm, danh mục..." value="${fn:escapeXml(param.q)}" autocomplete="off">
            <button type="submit" class="search-submit" aria-label="Tìm kiếm">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </form>
    </div>

    <div class="topbar-right">
        <nav class="topbar-nav">
            <a class="nav-link" href="${pageContext.request.contextPath}/product">Sản phẩm</a>
            <c:if test="${not empty sessionScope.account}">
                <a class="nav-link" href="${pageContext.request.contextPath}/products">Quản lý</a>
                <a class="nav-link" href="${pageContext.request.contextPath}/categories">Danh mục</a>
            </c:if>
        </nav>

        <div class="topbar-actions">
            <!-- Nút Wishlist yêu thích có hiệu ứng nảy tim -->
            <button type="button" class="btn-icon wishlist-btn" data-action="wishlist" title="Danh sách yêu thích">
                ♡
            </button>

            <!-- Nút Giỏ hàng có Badge nảy số lượng -->
            <button type="button" id="cart-trigger" class="btn-icon cart-trigger-btn" title="Xem giỏ hàng">
                <span class="cart-icon">🛒</span>
                <span id="cart-badge" class="cart-badge">0</span>
            </button>

            <!-- Avatar & Dropdown cá nhân -->
            <c:choose>
                <c:when test="${not empty sessionScope.account}">
                    <c:choose>
                        <c:when test="${fn:startsWith(sessionScope.account.avatar, 'http://') or fn:startsWith(sessionScope.account.avatar, 'https://')}">
                            <c:set var="topbarAvatar" value="${sessionScope.account.avatar}"/>
                        </c:when>
                        <c:when test="${not empty sessionScope.account.avatar}">
                            <c:url var="topbarAvatar" value="/image"><c:param name="fname" value="${sessionScope.account.avatar}"/></c:url>
                        </c:when>
                        <c:otherwise>
                            <c:set var="topbarAvatar" value="${pageContext.request.contextPath}/assets/default-category.svg"/>
                        </c:otherwise>
                    </c:choose>
                    <a class="user-chip" href="${pageContext.request.contextPath}/profile" title="Xem thông tin cá nhân">
                        <img class="avatar-mini" src="${fn:escapeXml(topbarAvatar)}" alt="Avatar">
                        <span class="user-name"><c:out value="${sessionScope.account.fullName}"/></span>
                    </a>
                    <a class="link-danger logout-btn" href="${pageContext.request.contextPath}/logout" title="Đăng xuất">
                        Đăng xuất
                    </a>
                </c:when>
                <c:otherwise>
                    <a class="button primary inline" href="${pageContext.request.contextPath}/login">Đăng nhập</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
